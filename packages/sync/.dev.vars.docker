# sync-worker 容器 .dev.vars (2026-08-07 v2: dotenv format)
# wrangler dev 读取此文件注入环境变量（dotenv 格式：key=value）
# 注意：wrangler dev 不透传未声明的 OS 环境变量，必须在此明确声明
# Beta 环境直传 URL base（与 beta ingress 域名一致）
LOCAL_DEV_HOST=https://endfield-api.hsyhhssyy.net

COMMIT_TOKEN_SECRET=dev-secret-key-32-bytes-long!!
R2_ACCESS_KEY_ID=dev
R2_SECRET_ACCESS_KEY=dev
R2_ACCOUNT_ID=dev
R2_BUCKET_NAME=dev
