# 仅供本地开发使用。生产环境请通过 Kubernetes Secret 注入。
# 二选一：支持 postgres://、postgresql:// 或 mysql://。
DATABASE_URL=postgres://industrial_planner:change-me@127.0.0.1:5432/industrial_planner
# DATABASE_URL=mysql://industrial_planner:change-me@127.0.0.1:3306/industrial_planner
REDIS_URL=redis://127.0.0.1:6379
HTTP_BIND_ADDR=0.0.0.0:8080
RUST_LOG=industrial_planner_backend=info,tower_http=info

# 只有直连对端位于这些网段时，才会信任 X-Forwarded-For。
# 未配置是安全默认值：忽略所有转发头。
TRUSTED_PROXY_CIDRS=

TELEMETRY_MAX_BODY_BYTES=65536
TELEMETRY_RATE_WINDOW_SECONDS=60
TELEMETRY_GLOBAL_RATE_LIMIT=600
TELEMETRY_IDENTITY_RATE_LIMIT=30
TELEMETRY_IP_RATE_LIMIT=60
DATABASE_MAX_CONNECTIONS=10
