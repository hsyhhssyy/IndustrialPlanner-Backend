{
  "_comment": "复制为 deploy-config.json，放入 GitHub Secrets DEPLOY_CONFIG",
  "registry": "your-registry.example.com",
  "username": "your-username",
  "password": "your-password",
  "image_name": "industrial-sync-dev",
  "stable": {
    "_comment": "正式环境：禁止匿名访问，匿名空间不可用",
    "namespace": "your-stable-namespace",
    "domain": "your-stable-domain.example.com",
    "cloudflare_api_token": "your-stable-cloudflare-api-token",
    "flags": {
      "_comment": "部署时分别注入匿名 Space 与 OAuth 登录能力开关；OAuth 关闭时 Provider 配置可暂留占位符",
      "allowAnonymousSpaces": false,
      "enableOAuth": false
    },
    "oauth": {
      "_comment": "OAuth 当前关闭；以下 OrangeAuth 配置只展示未来启用形态，不会在关闭时注入 Worker",
      "provider": {
        "type": "orangeauth",
        "orangeauth": {
          "baseUrl": "https://auth.yituliu.cn",
          "clientId": "<stable-orangeauth-client-id>",
          "scope": "user.read"
        }
      },
      "redirectUri": "<stable-oauth-redirect-uri>",
      "frontendRedirectUris": [
        "<stable-frontend-oauth-landing-uri>"
      ]
    },
    "d1": {
      "identityDatabaseId": "<stable-identity-d1-database-id>",
      "oauthDatabaseId": "<stable-oauth-d1-database-id>"
    },
    "secrets": {
      "sync": {
        "COMMIT_TOKEN_SECRET": "<secret>",
        "R2_ACCESS_KEY_ID": "<secret>",
        "R2_SECRET_ACCESS_KEY": "<secret>",
        "R2_ACCOUNT_ID": "<secret>",
        "R2_BUCKET_NAME": "<secret>",
        "JWT_SECRET": "<secret>"
      },
      "gateway": {
        "JWT_SECRET": "<secret>"
      },
      "identity": {
        "JWT_SECRET": "<secret>",
        "INTERNAL_SERVICE_SECRET": "<secret>"
      },
      "oauth": {
        "ORANGEAUTH_CLIENT_SECRET": "<secret>",
        "INTERNAL_SERVICE_SECRET": "<secret>"
      }
    },
    "_jwt_note": "同一环境内 sync/gateway/identity 的 JWT_SECRET 必须是同一个值"
  },
  "beta": {
    "_comment": "测试环境：只允许 e2e-cf-* 前端 E2E 空间匿名创建和访问；临时空间固定一小时后失效并由 Cron 清理，OAuth 登录也可用",
    "namespace": "your-namespace",
    "domain": "your-domain.example.com",
    "cloudflare_api_token": "your-beta-cloudflare-api-token",
    "flags": {
      "_comment": "部署时分别注入匿名 Space 与 OAuth 登录能力开关",
      "allowAnonymousSpaces": true,
      "enableOAuth": true
    },
    "oauth": {
      "_comment": "当前选择标准 OIDC；同一环境不得再提供 orangeauth 配置块",
      "provider": {
        "type": "oidc",
        "oidc": {
          "discoveryUrl": "<beta-oidc-discovery-url>",
          "clientId": "<beta-oidc-client-id>"
        }
      },
      "redirectUri": "<beta-oauth-redirect-uri>",
      "frontendRedirectUris": [
        "<beta-dev-frontend-oauth-landing-uri>",
        "<beta-pre-frontend-oauth-landing-uri>",
        "<beta-frontend-oauth-landing-uri>",
        "http://localhost:4174/auth/callback",
        "http://127.0.0.1:4174/auth/callback"
      ]
    },
    "d1": {
      "identityDatabaseId": "<beta-identity-d1-database-id>",
      "oauthDatabaseId": "<beta-oauth-d1-database-id>"
    },
    "secrets": {
      "sync": {
        "COMMIT_TOKEN_SECRET": "<secret>",
        "R2_ACCESS_KEY_ID": "<secret>",
        "R2_SECRET_ACCESS_KEY": "<secret>",
        "R2_ACCOUNT_ID": "<secret>",
        "R2_BUCKET_NAME": "<secret>",
        "JWT_SECRET": "<secret>"
      },
      "gateway": {
        "JWT_SECRET": "<secret>"
      },
      "identity": {
        "JWT_SECRET": "<secret>",
        "INTERNAL_SERVICE_SECRET": "<secret>"
      },
      "oauth": {
        "OIDC_CLIENT_SECRET": "<secret>",
        "INTERNAL_SERVICE_SECRET": "<secret>"
      }
    },
    "_jwt_note": "同一环境内 sync/gateway/identity 的 JWT_SECRET 必须是同一个值"
  }
}
