{
  "_comment": "复制为 deploy-config.json，放入 GitHub Secrets DEPLOY_CONFIG",
  "registry": "your-registry.example.com",
  "username": "your-username",
  "password": "your-password",
  "image_name": "industrial-sync-dev",
